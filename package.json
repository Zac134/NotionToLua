{
  "name": "notion-to-lua",
  "version": "0.1.1",
  "private": true,
  "description": "CLI to convert Notion database records into Roblox Luau ModuleScripts",
  "license": "MIT",
  "author": "yaSu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Zac134/NotionToLua.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "ntn-lua": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "test": "node --import tsx --test tests/**/*.test.ts",
    "sync": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "compile": "bash scripts/package-release.sh"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.9.2"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.20.6",
    "typescript": "^5.8.0"
  },
  "dependencies": {
    "@notionhq/client": "^5.23.0"
  }
}
